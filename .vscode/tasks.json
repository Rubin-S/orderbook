{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug"
      ],
      "dependsOn": "Configure debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run debug",
      "type": "process",
      "command": "${workspaceFolder}/build/debug/orderbook_demo",
      "dependsOn": "Build debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test debug",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "debug"
      ],
      "dependsOn": "Build debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Replay example (debug)",
      "type": "process",
      "command": "${workspaceFolder}/build/debug/orderbook_replay",
      "args": [
        "${workspaceFolder}/examples/session.csv"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "Build debug"
    },
    {
      "label": "Configure release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "Configure release"
    },
    {
      "label": "Benchmark (release)",
      "type": "process",
      "command": "${workspaceFolder}/build/release/orderbook_bench",
      "args": [
        "--operations",
        "100000",
        "--repetitions",
        "3",
        "--seed",
        "42"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "Build release"
    }
  ]
}

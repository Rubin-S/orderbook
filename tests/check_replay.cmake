file(READ "${SOURCE_DIR}/examples/session.expected" expected)
execute_process(COMMAND "${REPLAY}" "${SOURCE_DIR}/examples/session.csv" RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT actual STREQUAL expected OR NOT error STREQUAL "")
    message(FATAL_ERROR "File replay: status=${status}, stdout=${actual}, stderr=${error}")
endif()
execute_process(COMMAND "${REPLAY}" - INPUT_FILE "${SOURCE_DIR}/examples/session.csv" RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT actual STREQUAL expected OR NOT error STREQUAL "")
    message(FATAL_ERROR "Stdin replay: status=${status}, stdout=${actual}, stderr=${error}")
endif()
execute_process(COMMAND "${REPLAY}" --help RESULT_VARIABLE status OUTPUT_VARIABLE actual)
if(NOT status EQUAL 0 OR NOT actual MATCHES "Usage:")
    message(FATAL_ERROR "Help failed")
endif()
foreach(args IN ITEMS "" "--unknown" "${CMAKE_CURRENT_BINARY_DIR}/does-not-exist.csv")
    execute_process(COMMAND "${REPLAY}" ${args} RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE error)
    if(NOT status EQUAL 2 OR error STREQUAL "" OR actual MATCHES "SUMMARY")
        message(FATAL_ERROR "Invalid argument/file accepted: ${args}")
    endif()
endforeach()
execute_process(COMMAND "${REPLAY}" - extra RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 2 OR error STREQUAL "")
    message(FATAL_ERROR "Extra argument accepted")
endif()
set(bad "${CMAKE_CURRENT_BINARY_DIR}/replay-invalid.csv")
file(WRITE "${bad}" "CANCEL,7\nADD,2,BUY,12x,4,GTC\n")
execute_process(COMMAND "${REPLAY}" "${bad}" RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE error)
file(REMOVE "${bad}")
if(NOT status EQUAL 2 OR NOT error MATCHES "line 2" OR NOT actual STREQUAL "CANCEL,7,NOT_FOUND\n")
    message(FATAL_ERROR "Malformed replay: status=${status}, stdout=${actual}, stderr=${error}")
endif()
